{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xen xl domain configuration (JSON mapping)",
  "description": "JSON mapping for xl.cfg options, grouped by the official xl.cfg sections. Names follow xl.cfg; mini-languages remain strings and bracket-list options become JSON arrays.",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "description": "xl.cfg name; must be unique on the host." },
    "type": { "type": "string", "enum": ["pv", "pvh", "hvm"] },
    "builder": { "type": "string", "enum": ["generic", "hvm"], "deprecated": true },
    "uuid": { "type": "string", "format": "uuid" },

    "pool": { "type": "string" },
    "vcpus": { "type": "integer", "minimum": 1 },
    "maxvcpus": { "type": "integer", "minimum": 1 },
    "cpus": { "$ref": "#/$defs/cpuListOrPerVcpu" },
    "cpus_soft": { "$ref": "#/$defs/cpuListOrPerVcpu" },
    "cpu_weight": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "cap": { "type": "integer", "minimum": 0 },

    "memory": { "type": "integer", "minimum": 1, "description": "RAM in MB, matching xl.cfg memory= units." },
    "maxmem": { "type": "integer", "minimum": 1, "description": "Maximum guest RAM in MB." },
    "vnuma": { "type": "array", "items": { "$ref": "#/$defs/vnode" } },

    "on_poweroff": { "$ref": "#/$defs/domainAction" },
    "on_reboot": { "$ref": "#/$defs/domainAction" },
    "on_watchdog": { "$ref": "#/$defs/domainAction" },
    "on_crash": { "$ref": "#/$defs/domainAction" },
    "on_soft_reset": { "$ref": "#/$defs/domainAction" },

    "max_grant_frames": { "type": "integer", "minimum": 1 },
    "max_maptrack_frames": { "type": "integer", "minimum": 1 },
    "max_grant_version": { "type": "integer", "minimum": 1 },
    "xenstore_feature_mask": { "$ref": "#/$defs/nonNegativeInteger" },
    "xenstore_quota": { "type": "array", "items": { "type": "string", "pattern": "^[^=]+=\\d+$" } },
    "xend_suspend_evtchn_compat": { "type": "boolean" },
    "vmtrace_buf_kb": { "$ref": "#/$defs/nonNegativeInteger" },
    "vpmu": { "type": "boolean" },

    "kernel": { "type": "string", "minLength": 1 },
    "ramdisk": { "type": "string" },
    "cmdline": { "type": "string" },
    "root": { "type": "string" },
    "extra": { "type": "string" },
    "firmware": { "type": "string", "minLength": 1 },
    "pvshim": { "type": "boolean" },
    "pvshim_path": { "type": "string" },
    "pvshim_cmdline": { "type": "string" },
    "pvshim_extra": { "type": "string" },
    "bootloader": { "type": "string" },
    "bootloader_args": { "$ref": "#/$defs/stringOrStringArray" },
    "bootloader_restrict": { "type": "boolean" },
    "bootloader_user": { "type": "string" },
    "e820_host": { "type": "boolean" },

    "disk": { "type": "array", "items": { "$ref": "#/$defs/deviceSpec" } },
    "vif": { "type": "array", "items": { "$ref": "#/$defs/deviceSpec" } },
    "vtpm": { "type": "array", "items": { "$ref": "#/$defs/deviceSpec" } },
    "p9": { "type": "array", "items": { "$ref": "#/$defs/deviceSpec" } },
    "pvcalls": { "type": "array", "items": { "$ref": "#/$defs/deviceSpec" } },
    "vfb": { "type": "array", "items": { "$ref": "#/$defs/deviceSpec" } },
    "channel": { "type": "array", "items": { "$ref": "#/$defs/deviceSpec" } },
    "rdm": { "$ref": "#/$defs/stringOrStringArray" },
    "dtdev": { "$ref": "#/$defs/stringArray" },
    "ioports": { "$ref": "#/$defs/stringArray" },
    "iomem": { "$ref": "#/$defs/stringArray" },
    "irqs": { "type": "array", "items": { "$ref": "#/$defs/nonNegativeInteger" } },
    "max_event_channels": { "type": "integer", "minimum": 1 },
    "vdispl": { "type": "array", "items": { "$ref": "#/$defs/deviceSpec" } },
    "dm_restrict": { "type": "boolean" },
    "usbctrl": { "type": "array", "items": { "$ref": "#/$defs/deviceSpec" } },
    "usbdev": { "type": "array", "items": { "$ref": "#/$defs/deviceSpec" } },
    "pci": { "$ref": "#/$defs/stringArray" },
    "pci_permissive": { "type": "boolean" },
    "pci_msitranslate": { "type": "boolean" },
    "pci_seize": { "type": "boolean" },
    "pci_power_mgmt": { "type": "boolean" },
    "gfx_passthru": { "oneOf": [{ "type": "boolean" }, { "type": "string", "enum": ["0", "1", "default", "igd"] }] },
    "rdm_mem_boundary": { "type": "integer", "minimum": 0 },

    "boot": { "type": "string", "description": "HVM boot order string, as in xl.cfg." },
    "device_model_version": { "type": "string" },
    "device_model_override": { "type": "string" },
    "device_model_stubdomain_override": { "type": "boolean" },
    "device_model_stubdomain_seclabel": { "type": "string" },
    "device_model_args": { "$ref": "#/$defs/stringArray" },
    "device_model_args_pv": { "$ref": "#/$defs/stringArray" },
    "device_model_args_hvm": { "$ref": "#/$defs/stringArray" },
    "stubdomain_kernel": { "type": "string" },
    "stubdomain_ramdisk": { "type": "string" },
    "stubdomain_memory": { "type": "integer", "minimum": 1 },
    "vga": { "type": "string" },
    "vnc": { "type": "boolean" },
    "vncunused": { "type": "boolean" },
    "vnclisten": { "type": "string" },
    "vncpasswd": { "type": "string" },
    "vncdisplay": { "type": "integer", "minimum": 0 },
    "sdl": { "type": "boolean" },
    "spice": { "type": "boolean" },
    "display": { "type": "string" },
    "xauthority": { "type": "string" },
    "keymap": { "type": "string" },
    "spicehost": { "type": "string" },
    "spiceport": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "spicetls_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "spicedisable_ticketing": { "type": "boolean" },
    "spicepasswd": { "type": "string" },
    "spiceagent_mouse": { "type": "boolean" },
    "spicevdagent": { "type": "boolean" },
    "spice_clipboard_sharing": { "type": "boolean" },
    "spiceusbredirection": { "type": "integer", "minimum": 0 },
    "spice_image_compression": { "type": "string", "enum": ["auto_glz", "auto_lz", "quic", "glz", "lz", "off"] },
    "spice_streaming_video": { "type": "string", "enum": ["filter", "all", "off"] },
    "serial": { "$ref": "#/$defs/stringOrStringArray" },
    "soundhw": { "type": "string" },
    "vkb_device": { "type": "boolean" },
    "vkb": { "type": "array", "items": { "$ref": "#/$defs/deviceSpec" } },
    "usb": { "type": "boolean" },
    "usbversion": { "type": "integer", "enum": [1, 2, 3] },
    "usbdevice": { "$ref": "#/$defs/stringOrStringArray" },
    "vendor_device": { "type": "string", "enum": ["none", "xenserver"] },

    "hdtype": { "type": "string", "enum": ["ide", "ahci"] },
    "hap": { "type": "boolean" },
    "oos": { "type": "boolean" },
    "shadow_memory": { "type": "integer", "minimum": 0 },
    "bios": { "type": "string", "enum": ["rombios", "seabios", "ovmf"] },
    "bios_path_override": { "type": "string" },
    "pae": { "type": "boolean" },
    "acpi": { "type": "boolean" },
    "acpi_s3": { "type": "boolean" },
    "acpi_s4": { "type": "boolean" },
    "acpi_laptop_slate": { "type": "boolean" },
    "apic": { "type": "boolean" },
    "nx": { "type": "boolean" },
    "hpet": { "type": "boolean" },
    "hvm_pirq": { "type": "boolean" },
    "videoram": { "type": "integer", "minimum": 1 },
    "stdvga": { "type": "boolean", "deprecated": true },
    "nographic": { "type": "boolean" },
    "altp2m": { "type": "string", "enum": ["disabled", "mixed", "external", "limited"] },
    "altp2mhvm": { "type": "boolean", "deprecated": true },
    "altp2m_count": { "type": "integer", "minimum": 0 },
    "nestedhvm": { "type": "boolean" },
    "tsc_mode": { "type": "string", "enum": ["default", "always_emulate", "native"] },
    "localtime": { "type": "boolean" },
    "rtc_timeoffset": { "type": "integer" },
    "vpt_align": { "type": "boolean" },
    "timer_mode": { "type": "string", "enum": ["delay_for_missed_ticks", "no_delay_for_missed_ticks", "no_missed_ticks_pending", "one_missed_tick_pending"] },
    "mmio_hole": { "type": "integer", "minimum": 256, "maximum": 3840 },
    "xen_platform_pci": { "type": "boolean" },
    "xen_platform_pci_bar_uc": { "type": "boolean" },
    "viridian": { "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/stringArray" }] },
    "tee": { "type": "string", "enum": ["none", "optee"] },
    "ffa": { "type": "boolean" },
    "gic_version": { "type": "string", "enum": ["v2", "v3", "default"] },
    "vuart": { "type": "string", "enum": ["sbsa_uart"] },
    "sve": { "type": "string", "enum": ["disabled", "128", "256", "384", "512", "640", "768", "896", "1024", "1152", "1280", "1408", "1536", "1664", "1792", "1920", "2048", "hw"] },
    "llc_colors": { "$ref": "#/$defs/stringArray" },
    "nr_spis": { "$ref": "#/$defs/stringOrInteger" },
    "trap_unmapped_accesses": { "type": "boolean" },
    "arm_sci": { "$ref": "#/$defs/deviceSpec" },
    "mca_caps": { "$ref": "#/$defs/stringArray" },
    "msr_relaxed": { "type": "boolean" },

    "nomigrate": { "type": "boolean" },
    "driver_domain": { "type": "boolean" },
    "seclabel": { "type": "string" },
    "init_seclabel": { "type": "string" },
    "passthrough": { "type": "string", "enum": ["disabled", "enabled", "sync_pt", "share_pt", "default"] },
    "device_tree": { "type": "string" },
    "acpi_firmware": { "type": "string" },
    "smbios_firmware": { "type": "string" },
    "stubdomain_cmdline": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "domainAction": {
      "type": "string",
      "enum": ["destroy", "restart", "rename-restart", "preserve", "coredump-destroy", "coredump-restart", "soft-reset"]
    },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "stringOrStringArray": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/stringArray" }] },
    "stringOrInteger": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
    "cpuListOrPerVcpu": {
      "oneOf": [
        { "type": "string", "minLength": 1, "description": "xl CPU-list expression, e.g. all,^2-4 or nodes:0-1." },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Per-vCPU CPU-list expressions, matching xl.cfg list form." }
      ]
    },
    "deviceSpec": {
      "description": "A native xl device specification string, or a JSON object using the same option names. Strings preserve direct xl.cfg compatibility; objects are easier to validate and will need serialization by the backend.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["string", "integer", "number", "boolean"] } }
      ]
    },
    "vnode": {
      "type": "object",
      "required": ["pnode", "size", "vcpus", "vdistances"],
      "properties": {
        "pnode": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 1, "description": "Memory in MB." },
        "vcpus": { "type": "string", "minLength": 1, "description": "xl CPU-list expression for guest vCPUs." },
        "vdistances": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 }
      },
      "additionalProperties": false
    }
  }
}
